{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build AutoPickup",
      "detail": "Builds AutoPickup and copies the DLL and config to builds/autopickup/",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\build-mod.ps1",
        "-Mod",
        "AutoPickup"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": "$rustc"
    },
